{
  "agybar-tracker": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/hook_runner.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/hook_runner.py",
        "timeout": 5
      }
    ]
  }
}
